# خدمة تشغيل عميل الباص تلقائياً عند الإقلاع (انسخها إلى /etc/systemd/system/)
[Unit]
Description=Smart School Bus device client
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Smart-School-Bus-System/Bus backend
EnvironmentFile=/home/pi/bus.env
ExecStart=/usr/bin/python3 pi_client.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
