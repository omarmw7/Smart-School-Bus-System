# شاشة السائق: تفتح Chromium بوضع kiosk على /driver (انسخها إلى /etc/systemd/system/)
[Unit]
Description=Driver screen kiosk
After=graphical.target

[Service]
User=pi
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium-browser --kiosk --noerrdialogs --disable-infobars --incognito "https://YOUR-DOMAIN/driver?bus=1"
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
